  <cdkey cdkey="37youxi"/>
  </key>
  
  <key name="公测礼包" id="10001" time="1" alltime="100" severnum="-1" start="-1" end="-1">
  <item item="10000014,10000015,10000016" num="4,5,6"/>
  
  <cdkey cdkey="xygc"/>
  </key>
  <pf pfid="1" txt="请点击虚浮球联系客服领取礼包！"/>
  <pf pfid="2" txt="玩家交流群：714642639，群里不定期会发放礼包哦！"/>
  <pf pfid="4" txt="关注公众号：【霹雳天团】 每周五发放周礼包.加入玩家交流群：【663060444】"/>
